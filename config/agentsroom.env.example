# CLI backends use the CLI's own sign-in; no LLM API key is needed here.
TRADINGAGENTS_LLM_PROVIDER=codex_cli
TRADINGAGENTS_QUICK_THINK_LLM=default
TRADINGAGENTS_DEEP_THINK_LLM=default
# Optional split: analysts/researchers/trader on agy, managers on Codex.
#TRADINGAGENTS_QUICK_THINK_PROVIDER=agy_cli
#TRADINGAGENTS_DEEP_THINK_PROVIDER=codex_cli

TRADINGAGENTS_OUTPUT_LANGUAGE=Vietnamese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_CLI_TIMEOUT=300
# Use absolute executable paths if the desktop application's PATH differs.
#TRADINGAGENTS_CODEX_BIN=/opt/homebrew/bin/codex
#TRADINGAGENTS_AGY_BIN=/Users/yourname/.local/bin/agy
# All data sources remain those configured by upstream. Vietnam data is not added.
